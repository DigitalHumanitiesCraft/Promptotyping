{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dhcraft.org/Promptotyping/schema/knowledge-document.schema.json",
  "title": "Knowledge Document frontmatter",
  "description": "Machine-readable form of the frontmatter vocabulary of the Knowledge Documents convention (https://dhcraft.org/Promptotyping/#konvention-v0.1, section Frontmatter schema). The convention text is normative; this schema mirrors it for validation and drifts are a defect. The mandatory core is required; the recommended and context-dependent layers are optional and additional project-specific fields are permitted. The status vocabulary is the full list the released templates carry, which governs over the convention text's abbreviation (site INDEX, status vocabulary).",
  "version": "0.1",
  "type": "object",
  "required": ["title", "project", "method", "status", "created", "updated"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "project": {
      "type": "object",
      "required": ["name", "repository"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 }
      }
    },
    "method": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "status": {
      "enum": ["idea", "draft", "stub", "complete", "reviewed", "archived", "active", "snapshot"]
    },
    "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "template": {
      "type": "object",
      "required": ["name", "version", "url"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": ["string", "number"] },
        "url": { "type": "string", "format": "uri" },
        "alias": { "type": "string", "format": "uri" }
      }
    },
    "authors": { "type": "array", "items": { "type": "string" }, "description": "Humans with curatorial responsibility; never an LLM." },
    "generated-with": { "type": "string", "description": "Harness and LLM in the form 'Harness (LLM)'." },
    "topics": { "type": "array", "items": { "type": "string" } },
    "language": { "type": "string", "pattern": "^[a-z]{2}$" },
    "version": { "type": ["string", "number"], "description": "Repository-wide schema version, raised jointly." },
    "related": { "type": "array", "items": { "type": "string" } },
    "output-of": { "type": "string", "description": "Reproducing command; the document is not edited by hand where this stands." },
    "knowledge-sources": { "type": "object" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "iteration": { "type": "integer" },
    "baseline": { "type": "string" },
    "feedback-source": { "type": "string" },
    "verification-milestone": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
